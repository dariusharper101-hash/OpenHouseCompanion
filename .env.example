# ─── Admin dashboard (HTTP Basic Auth on /admin) ──────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ─── Supabase (shared lead database) ──────────────────────────────────────────
# Find these in your Supabase project: Settings → API
# - SUPABASE_URL is the "Project URL"
# - SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key (server-only —
#   never expose it to the browser or commit it).
# If these are unset, the app falls back to local file storage (dev/preview only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── New-lead email notifications (optional) ──────────────────────────────────
# Get a free API key at resend.com. If unset, notifications are skipped silently
# (leads still save). NOTIFY_EMAIL is where alerts go. NOTIFY_FROM must be a
# verified sender for production; the default works for testing.
RESEND_API_KEY=
NOTIFY_EMAIL=
# NOTIFY_FROM="Open House Companion <onboarding@resend.dev>"
